{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 1.3 deterministic answer contract",
  "type": "object",
  "properties": {
    "answers": {
      "type": "object",
      "properties": {
        "trace_diagnosis": {
          "type": "object",
          "properties": {
            "boundary": {
              "type": "string",
              "enum": [
                "api-to-queue-to-worker",
                "worker-to-model",
                "api-to-database"
              ],
              "description": "Faulty context propagation boundary."
            },
            "carrier": {
              "type": "string",
              "enum": [
                "not-injected-or-restored",
                "propagated-correctly",
                "invalid-job-json"
              ],
              "description": "Cause visible in queue source."
            },
            "worker_context": {
              "type": "string",
              "enum": [
                "not-extracted",
                "extracted-parent",
                "no-worker-tracer"
              ],
              "description": "How the starter creates the processing span."
            },
            "causal_claim": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classify the explanation that these source defects cause separate runtime traces."
            }
          },
          "required": [
            "boundary",
            "carrier",
            "worker_context",
            "causal_claim"
          ],
          "additionalProperties": false
        },
        "metric_diagnosis": {
          "type": "object",
          "properties": {
            "unit_fault": {
              "type": "string",
              "enum": [
                "seconds-multiplied-by-1000",
                "seconds-divided-by-1000",
                "correct-seconds"
              ],
              "description": "Starter observation conversion."
            },
            "cardinality_fault": {
              "type": "string",
              "enum": [
                "per-exception-request-id",
                "bounded-route",
                "none"
              ],
              "description": "Starter dimension responsible for growth."
            },
            "impact": {
              "type": "string",
              "enum": [
                "new-series-per-exception-and-inflated-duration",
                "missing-database-row",
                "no-impact"
              ],
              "description": "Effect of the combined defects."
            }
          },
          "required": [
            "unit_fault",
            "cardinality_fault",
            "impact"
          ],
          "additionalProperties": false
        },
        "before_trace_evidence": {
          "type": "object",
          "properties": {
            "continuity": {
              "type": "string",
              "enum": [
                "single-parent-chain",
                "separate-traces",
                "no-worker-span"
              ],
              "description": "Compare actual publisher and processing span trace IDs and CHILD_OF references."
            },
            "model_parent": {
              "type": "string",
              "enum": [
                "worker-processing",
                "api-request",
                "no-parent"
              ],
              "description": "Parent of model_provider.summarize."
            },
            "correlation_basis": {
              "type": "string",
              "enum": [
                "exception-id",
                "timestamp-proximity",
                "no-shared-identity"
              ],
              "description": "Shared durable identity linking HTTP, stream, worker and saved record."
            },
            "classification": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classification of the trace relationship directly visible in this capture."
            }
          },
          "required": [
            "continuity",
            "model_parent",
            "correlation_basis",
            "classification"
          ],
          "additionalProperties": false
        },
        "after_trace_evidence": {
          "type": "object",
          "properties": {
            "continuity": {
              "type": "string",
              "enum": [
                "single-parent-chain",
                "separate-traces",
                "no-worker-span"
              ],
              "description": "Compare actual publisher and processing span trace IDs and CHILD_OF references."
            },
            "model_parent": {
              "type": "string",
              "enum": [
                "worker-processing",
                "api-request",
                "no-parent"
              ],
              "description": "Parent of model_provider.summarize."
            },
            "correlation_basis": {
              "type": "string",
              "enum": [
                "exception-id",
                "timestamp-proximity",
                "no-shared-identity"
              ],
              "description": "Shared durable identity linking HTTP, stream, worker and saved record."
            },
            "classification": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classification of the trace relationship directly visible in this capture."
            }
          },
          "required": [
            "continuity",
            "model_parent",
            "correlation_basis",
            "classification"
          ],
          "additionalProperties": false
        },
        "before_metric_evidence": {
          "type": "object",
          "properties": {
            "recorded_unit": {
              "type": "string",
              "enum": [
                "seconds",
                "milliseconds",
                "unknown"
              ],
              "description": "Unit of observations, considering source and accepted-to-terminal timestamps."
            },
            "application_labels": {
              "type": "string",
              "enum": [
                "none",
                "request_id",
                "shipment_id"
              ],
              "description": "Application labels on the histogram, excluding Prometheus job/instance and bucket le."
            },
            "dashboard_result": {
              "type": "string",
              "enum": [
                "empty-vector",
                "finite-seconds-value",
                "query-error"
              ],
              "description": "Captured response to the published dashboard query."
            },
            "classification": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classification of the query result directly visible in this capture."
            }
          },
          "required": [
            "recorded_unit",
            "application_labels",
            "dashboard_result",
            "classification"
          ],
          "additionalProperties": false
        },
        "after_metric_evidence": {
          "type": "object",
          "properties": {
            "recorded_unit": {
              "type": "string",
              "enum": [
                "seconds",
                "milliseconds",
                "unknown"
              ],
              "description": "Unit of observations, considering source and accepted-to-terminal timestamps."
            },
            "application_labels": {
              "type": "string",
              "enum": [
                "none",
                "request_id",
                "shipment_id"
              ],
              "description": "Application labels on the histogram, excluding Prometheus job/instance and bucket le."
            },
            "dashboard_result": {
              "type": "string",
              "enum": [
                "empty-vector",
                "finite-seconds-value",
                "query-error"
              ],
              "description": "Captured response to the published dashboard query."
            },
            "classification": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classification of the query result directly visible in this capture."
            }
          },
          "required": [
            "recorded_unit",
            "application_labels",
            "dashboard_result",
            "classification"
          ],
          "additionalProperties": false
        },
        "behavior_and_limits": {
          "type": "object",
          "properties": {
            "exception_state": {
              "type": "string",
              "enum": [
                "COMPLETED",
                "FAILED",
                "QUEUED"
              ],
              "description": "Terminal state in both captures."
            },
            "normal_http_status": {
              "type": "integer",
              "enum": [
                200,
                202,
                422,
                500
              ],
              "description": "In-range POST status in both captures."
            },
            "summary_comparison": {
              "type": "string",
              "enum": [
                "unchanged-for-equivalent-input",
                "missing-after",
                "different-condition"
              ],
              "description": "Compare captured summaries for the same synthetic shipment and temperature."
            },
            "business_claim_classification": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Classification of the captured state/status/summary comparison."
            },
            "production_slo_claim": {
              "type": "string",
              "enum": [
                "observation",
                "inference",
                "not-established"
              ],
              "description": "Does the pack establish the production p95 latency SLO?"
            }
          },
          "required": [
            "exception_state",
            "normal_http_status",
            "summary_comparison",
            "business_claim_classification",
            "production_slo_claim"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "trace_diagnosis",
        "metric_diagnosis",
        "before_trace_evidence",
        "after_trace_evidence",
        "before_metric_evidence",
        "after_metric_evidence",
        "behavior_and_limits"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "answers"
  ],
  "additionalProperties": false
}
